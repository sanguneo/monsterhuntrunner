{
  "name": "monster-hunter-runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-creature-chunks.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\"",
    "art:export": "node scripts/art/run-export.mjs",
    "art:validate": "python3 scripts/art/validate-glb.py .art/final",
    "art:qa": "node scripts/art/run-character-qa.mjs",
    "art:textures": "node scripts/art/run-texture-checks.mjs"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.62.1",
    "vite": "^5.4.0",
    "vitest": "2.1.9"
  }
}
